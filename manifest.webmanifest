{
  "id": "./",
  "name": "Dentaly",
  "short_name": "Dentaly",
  "description": "Agenda, expedientes, cobros y material del consultorio Dentaly",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F6F8F7",
  "theme_color": "#0B4F4A",
  "lang": "es-MX",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "categories": [
    "medical",
    "business",
    "productivity"
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Agenda",
      "short_name": "Agenda",
      "description": "Las citas de hoy",
      "url": "./?agenda=1",
      "icons": [
        {
          "src": "sc-agenda.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Nueva cita",
      "short_name": "Nueva cita",
      "description": "Agendar a un paciente",
      "url": "./?accion=cita",
      "icons": [
        {
          "src": "sc-cita.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Escanear material",
      "short_name": "Escanear",
      "description": "Saqué o llegó material",
      "url": "./?inv=",
      "icons": [
        {
          "src": "sc-escanear.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Inicio",
      "short_name": "Inicio",
      "description": "Pendientes del día",
      "url": "./?inicio=1",
      "icons": [
        {
          "src": "sc-inicio.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./compartir",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "fotos",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}